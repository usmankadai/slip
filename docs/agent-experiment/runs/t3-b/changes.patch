+import styles from './StatusCell.module.css';
+
+/** An activity's progress status in one update. */
+export type ActivityStatus = 'not-started' | 'in-progress' | 'complete';
+
+export interface StatusCellProps {
+  /** The status, or null when the update does not say. */
+  status: ActivityStatus | null;
+}
+
+export const STATUS_WORDS: Record<ActivityStatus, string> = {
+  'not-started': 'Not started',
+  'in-progress': 'In progress',
+  complete: 'Complete',
+};
+
+/** A circle that fills as the activity progresses: empty, half, full. Drawn in the text colour. */
+function Glyph({ status }: { status: ActivityStatus }) {
+  return (
+    <svg className={styles.glyph} viewBox="0 0 10 10" aria-hidden="true" focusable="false">
+      <circle className={styles.ring} cx="5" cy="5" r="4.25" />
+      {status === 'in-progress' ? (
+        <path className={styles.fill} d="M5 0.75 A4.25 4.25 0 0 0 5 9.25 Z" />
+      ) : null}
+      {status === 'complete' ? <circle className={styles.fill} cx="5" cy="5" r="4.25" /> : null}
+    </svg>
+  );
+}
+
+/**
+ * An activity's status as a small neutral badge: a word, and a circle that is empty, half
+ * or full, so it reads without colour and can be scanned without reading the word.
+ */
+export function StatusCell({ status }: StatusCellProps) {
+  if (status === null || !Object.hasOwn(STATUS_WORDS, status)) {
+    return <span className={styles.empty} />;
+  }
+  return (
+    <span className={styles.badge} data-status={status}>
+      <Glyph status={status} />
+      {STATUS_WORDS[status]}
+    </span>
+  );
+}
