@@ -0,0 +1,63 @@
+import { describe, expect, it, vi } from 'vitest';
+import { EngineSession, type EngineRequest } from '@slip/engine';
+import { parseXerText } from '@slip/xer';
+import update01 from '../../../../../fixtures/synthetic/rail-1k/update-01.xer?raw';
+import update02 from '../../../../../fixtures/synthetic/rail-1k/update-02.xer?raw';
+import expected from '../../../../../fixtures/synthetic/rail-1k/expected.json';
+import { ADDED_ROWS, addedFoot } from './model.ts';
+
+const session = new EngineSession();
+vi.mock('../../app/engine.ts', () => ({
+  engine: () => ({ request: async (request: EngineRequest) => session.handle(request) }),
+}));
+
+const { fetchAddedList } = await import('./useSummary.ts');
+
+const load = (a: string, b: string) => {
+  session.handle({ type: 'load', slot: 'a', data: parseXerText(a) });
+  session.handle({ type: 'load', slot: 'b', data: parseXerText(b) });
+};
+
+describe('fetchAddedList', () => {
+  it('lists the activities the generator added, earliest finish first, with their index in update B', async () => {
+    load(update01, update02);
+    const list = await fetchAddedList();
+    expect(list.total).toBe(expected.changes.added.length);
+    expect(list.rows.map((row) => row.code).sort()).toEqual([...expected.changes.added].sort());
+    for (let k = 1; k < list.rows.length; k++) {
+      expect(list.rows[k]!.finish).toBeGreaterThanOrEqual(list.rows[k - 1]!.finish);
+    }
+    for (const row of list.rows) {
+      expect(row.name).not.toBe('');
+      // The index leads the grid to exactly this activity: its row in the grid holds this code.
+      const located = session.handle({ type: 'locate', slot: 'b', activity: row.activity });
+      if (located.type !== 'locate') throw new Error('expected a locate result');
+      const at = session.handle({
+        type: 'rows',
+        slot: 'b',
+        range: [located.row, located.row + 1],
+        columns: ['code'],
+      });
+      expect(at.type === 'rows' && at.text.code?.[0]).toBe(row.code);
+    }
+  });
+
+  it('finds nothing added when both updates are the same file', async () => {
+    load(update01, update01);
+    const list = await fetchAddedList();
+    expect(list).toEqual({ rows: [], total: 0 });
+  });
+});
+
+describe('addedFoot', () => {
+  const row = { activity: 0, code: 'A1', name: 'Activity', finish: 0 };
+
+  it('says nothing when every added activity is listed', () => {
+    expect(addedFoot({ rows: [row, row], total: 2 })).toBe('');
+  });
+
+  it('says how many of how many when the list is cut short', () => {
+    const rows = Array.from({ length: ADDED_ROWS }, () => row);
+    expect(addedFoot({ rows, total: 3_180 })).toBe('Showing the 10 that finish first, of 3,180.');
+  });
+});
