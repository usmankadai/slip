+import styles from './StatusCell.module.css';
+
+/** An activity's progress status, as P6 records it. */
+export type ActivityStatus = 'notStarted' | 'inProgress' | 'complete';
+
+export interface StatusCellProps {
+  /** The status, or null when the file did not give one Slip recognises. */
+  status: ActivityStatus | null;
+}
+
+const WORDS: Record<ActivityStatus, string> = {
+  notStarted: 'Not started',
+  inProgress: 'In progress',
+  complete: 'Complete',
+};
+
+/** The word for a status, as the badge writes it. */
+export function statusWord(status: ActivityStatus): string {
+  return WORDS[status];
+}
+
+/**
+ * An activity's status as a small badge: a word, and a circle that is empty, half filled or
+ * filled. The word and the shape carry the meaning, so it never depends on colour.
+ */
+export function StatusCell({ status }: StatusCellProps) {
+  if (status === null) return <span className={styles.unknown}>Not known</span>;
+  return (
+    <span className={styles.badge}>
+      <span className={`${styles.glyph} ${styles[status]}`} aria-hidden="true" />
+      {WORDS[status]}
+    </span>
+  );
+}
