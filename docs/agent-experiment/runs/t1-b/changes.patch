 /** Words and numbers for the import screen. Dates are wall-clock integers (D13); no Date object is used. */
-import { formatXerDate } from '@slip/xer';
+import { ConstraintType, NONE, formatXerDate } from '@slip/xer';
+
+/** A P6 constraint type in words, as a planner says it. */
+export const CONSTRAINT_WORDS: Record<number, string> = {
+  [ConstraintType.None]: 'None',
+  [ConstraintType.StartOn]: 'Start on',
+  [ConstraintType.StartOnOrAfter]: 'Start on or after',
+  [ConstraintType.StartOnOrBefore]: 'Start on or before',
+  [ConstraintType.FinishOn]: 'Finish on',
+  [ConstraintType.FinishOnOrAfter]: 'Finish on or after',
+  [ConstraintType.FinishOnOrBefore]: 'Finish on or before',
+  [ConstraintType.MandatoryStart]: 'Mandatory start',
+  [ConstraintType.MandatoryFinish]: 'Mandatory finish',
+  [ConstraintType.AsLateAsPossible]: 'As late as possible',
+};
+
+/**
+ * An activity's constraint for a grid cell: "Start on or after 2 Jun 2027". '' when it has
+ * none. A type P6 does not define reads "Unknown constraint"; a type with no date reads as
+ * the type alone, as "As late as possible" always does.
+ */
+export function constraintCell(type: number, date: number): string {
+  if (type === ConstraintType.None || type === NONE || !Number.isInteger(type)) return '';
+  const words = CONSTRAINT_WORDS[type] ?? 'Unknown constraint';
+  const when = type === ConstraintType.AsLateAsPossible ? '' : shortDate(date);
+  return when ? `${words} ${when}` : words;
+}
 
