{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@slip/web", "dev", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@slip/web", "preview", "--port", "4174", "--strictPort"],
      "port": 4174
    },
    {
      "name": "design",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@slip/web",
        "exec",
        "vite",
        "../../docs/design",
        "--port",
        "4180",
        "--strictPort"
      ],
      "port": 4180
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@slip/ui", "storybook"],
      "port": 6006
    }
  ]
}
