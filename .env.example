# Every variable is optional. With none set, the app runs in scripted agent mode.

# Server only. Never prefix these with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AGENT_MODE=scripted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browser. Error reporting stays off unless this is set.
VITE_SENTRY_DSN=
