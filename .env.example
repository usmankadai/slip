# Every variable is optional. With none set, the app runs in scripted agent mode.

# Server only. Never prefix these with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AGENT_MODE=scripted
# Suggested: claude-opus-5-5. Effort is one of low, medium, high, xhigh, max.
AGENT_EFFORT=medium
# The web app's origin, the only one allowed to call the API from a browser.
APP_ORIGIN=http://localhost:5173
AGENT_QUESTIONS_PER_WINDOW=20
AGENT_WINDOW_MINUTES=10
AGENT_DAILY_CALL_CAP=2000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browser. Error reporting stays off unless this is set.
VITE_SENTRY_DSN=
